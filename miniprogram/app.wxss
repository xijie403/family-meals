/* ============================================================
   栖栖家的菜谱 · 全局设计系统 v2（现代卡通风）
   ------------------------------------------------------------
   语言：奶油底 + 纯白浮层 + 柔和投影 + 圆润胶囊 + 糖果点缀
   原则：不用粗描边、不用硬立体边，靠「柔和阴影 + 轻微抬升」表达层级
   ============================================================ */

page {
  /* —— 主色：糖果橙（渐变用于按钮/选中态）—— */
  --brand: #FF7A33;
  --brand-2: #FF9A4D;
  --brand-3: #FF6B2C;
  --brand-soft: #FFF1E6;
  --brand-deep: #E0591A;

  /* —— 分类 / 统计点缀色 —— */
  --green: #4FB85F;
  --yellow: #FFAE1A;
  --blue: #4FA8E8;
  --pink: #E45C8A;
  --purple: #9E7BE0;

  /* —— 中性 —— */
  --bg: #FFF9F4;
  --line: #F4EAE0;
  --ink: #3D3229;
  --ink-2: #6B5947;
  --muted: #B3A492;

  /* —— 柔和投影（替代描边）—— */
  --sh-1: 0 4rpx 14rpx rgba(178, 140, 102, 0.09);
  --sh-2: 0 8rpx 22rpx rgba(178, 140, 102, 0.13);
  --sh-brand: 0 10rpx 24rpx rgba(255, 107, 44, 0.30);

  background: var(--bg);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------------- 页面标题（各 tab 页统一） ---------------- */

.hd {
  padding: 34rpx 34rpx 14rpx;
}

.hd-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.22;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

/* 标题旁的卡通贴纸：糖果圆角底 + 轻微倾斜，页面更活泼 */
.hd-emo {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  transform: rotate(-6deg);
  box-shadow: 0 6rpx 14rpx rgba(255, 140, 70, 0.2);
}

.hd-sub {
  font-size: 25rpx;
  color: var(--muted);
  margin-top: 10rpx;
}

/* ---------------- 胶囊标签 ----------------
   注意：这里**不要**写 overflow-x: auto。
   给 view 加 overflow-x:auto 后，只要内容比屏幕宽一点点，
   就会在底部渲染出一条灰色横向滚动条（菜单页 .flt 就踩过这个坑）。
   真要横向滚动请改用 scroll-view + show-scrollbar="{{false}}"。 */

.tabs {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 30rpx;
  flex-wrap: wrap;
}

.tab {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 13rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  background: #fff;
  box-shadow: var(--sh-1);
  flex-shrink: 0;
}

.tab-ico {
  width: 34rpx;
  height: 34rpx;
  display: block;
  flex-shrink: 0;
}

.tab.on {
  background: linear-gradient(135deg, var(--brand-2), var(--brand-3));
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 44, 0.28);
}

/* ---------------- 卡片（浮层，不描边） ---------------- */

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
  padding: 22rpx 30rpx;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

/* 选中：抬升 + 橙色光晕，不再用描边 */
.card.on {
  transform: translateY(-6rpx);
  box-shadow: 0 16rpx 32rpx rgba(255, 107, 44, 0.28);
}

.card.on .card-name {
  color: var(--brand-deep);
}

.card-img {
  width: 100%;
  height: 200rpx;
  background: #F6EFE7;
  display: block;
}

.card-body {
  padding: 16rpx 18rpx 20rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.card-cat {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* 右上角序号：选中才出现，未选中显示一个「＋」 */
.badge-seq {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-2), var(--brand-3));
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(255, 107, 44, 0.42);
}

.badge-seq.off {
  background: rgba(255, 255, 255, 0.88);
  color: #C0B2A0;
  font-size: 32rpx;
  font-weight: 400;
  box-shadow: 0 4rpx 12rpx rgba(90, 60, 30, 0.14);
}

/* ---------------- 底部操作条（悬浮胶囊） ---------------- */

.bar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 249, 244, 0), #FFF9F4 36%);
  z-index: 20;
}

.bar {
  height: 104rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(178, 140, 102, 0.20);
  color: var(--brand-deep);
  font-weight: 700;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 38rpx;
  box-sizing: border-box;
  transition: transform 0.14s ease, box-shadow 0.14s ease;
}

.bar.solid {
  background: linear-gradient(135deg, var(--brand-2), var(--brand-3));
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(255, 107, 44, 0.34);
}

.bar:active {
  transform: translateY(2rpx) scale(0.995);
  box-shadow: 0 6rpx 16rpx rgba(178, 140, 102, 0.18);
}

/* ---------------- 按钮 ---------------- */

.btn {
  margin: 30rpx 0 0;
  padding: 28rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand-2), var(--brand-3));
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: var(--sh-brand);
  transition: transform 0.14s ease, box-shadow 0.14s ease;
}

.btn:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 44, 0.26);
}

.btn.ghost {
  background: #fff;
  color: var(--brand);
  box-shadow: var(--sh-2);
  margin-top: 22rpx;
}

/* ---------------- 表单输入（全站统一写法，别再改回去） ----------------
   原生 <input> 必须「显式高度 + 只给左右内边距」。
   反例：写 `padding: 26rpx 28rpx`（上下也留白）却不写 height ——
   安卓上原生输入框的文字会被顶到顶边、上下被裁，占位文案和自己输入的字都显示不全。
   正解：height + 左右 padding，垂直方向交给高度自己撑。 */
.f-input {
  display: block;
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  color: var(--ink);
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(178, 140, 102, 0.10);
}

.f-input-ph {
  color: #C4B7A6;
  font-size: 30rpx;
}

/* ---------------- 空状态 / 提示 ---------------- */

.empty {
  padding: 130rpx 60rpx;
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
}

.e-title {
  font-size: 36rpx;
  color: var(--ink);
  font-weight: 700;
}

.hint {
  font-size: 24rpx;
  color: var(--muted);
  padding: 14rpx 30rpx;
  line-height: 1.75;
}

.muted {
  color: var(--muted);
}

/* ---------------- 通用列表行（菜谱页） ---------------- */

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: var(--sh-1);
  margin: 0 26rpx 16rpx;
  box-sizing: border-box;
  transition: transform 0.14s ease;
}

.row:active {
  transform: scale(0.985);
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 22rpx;
  background: #F6EFE7;
  flex-shrink: 0;
}

.row-title {
  font-size: 32rpx;
  font-weight: 600;
}

.row-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
