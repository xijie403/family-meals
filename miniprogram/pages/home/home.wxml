<view class="home">
  <!-- 背景装饰 -->
  <view class="blob b1"></view>
  <view class="blob b2"></view>
  <view class="blob b3"></view>
  <text class="sp s1">✦</text>
  <text class="sp s2">✦</text>
  <text class="sp s3">✦</text>

  <view class="in">
    <view class="hero-wrap">
      <image class="hero" src="/images/hero.png" mode="aspectFit" />
    </view>
    <view class="name">{{homeName}}</view>
    <view class="slogan">{{slogan}}</view>
    <view class="btn" bindtap="start">开始点菜</view>
    <view class="tip">点一点，选出今天想吃的菜</view>
  </view>
</view>
