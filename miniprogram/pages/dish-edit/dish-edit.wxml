<view class="page">
  <view class="batch-tip" wx:if="{{mode === 'batch'}}">
    <text>第 {{batchIdx + 1}} / {{batchTotal}} 张</text>
    <text class="batch-skip" bindtap="skipBatch">放弃剩下的</text>
  </view>

  <view class="picker" bindtap="chooseImg">
    <image wx:if="{{cover}}" class="cover" src="{{cover}}" mode="aspectFill" />
    <view wx:else class="cover cover-ph">
      <view class="cover-ph-txt">点这里选一张做好的菜</view>
    </view>
  </view>

  <view class="field">
    <view class="label">菜名</view>
    <input
      class="f-input"
      placeholder="{{mode === 'batch' ? '第 ' + (batchIdx + 1) + ' 张叫什么' : '比如 红烧肉'}}"
      placeholder-class="f-input-ph"
      value="{{name}}"
      focus="{{autoFocus}}"
      confirm-type="done"
      bindinput="onName"
      bindconfirm="onConfirm"
    />
    <view class="tip" wx:if="{{mode === 'batch'}}">填好按键盘「完成」即可存这张并跳下一张</view>
  </view>

  <view class="field">
    <view class="label">分类<text class="label-opt">可跳过</text></view>
    <view class="cats">
      <view
        wx:for="{{cats}}"
        wx:key="key"
        class="pill {{cat === item.key ? 'on' : ''}}"
        data-cat="{{item.key}}"
        bindtap="pickCat"
      >
        <image class="cat-ico" src="{{cat === item.key ? item.iconOn : item.icon}}" />
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="field">
    <view class="label">食材<text class="label-opt">可留空，填了才会进买菜清单</text></view>
    <input
      class="f-input"
      placeholder="五花肉、生抽、冰糖"
      placeholder-class="f-input-ph"
      value="{{ingText}}"
      bindinput="onIng"
    />
    <view class="tip">用逗号或顿号隔开</view>
  </view>

  <view class="del-box" wx:if="{{isEdit}}">
    <view class="del" bindtap="remove">删除这道菜</view>
  </view>

  <view class="bar-wrap">
    <view class="bar solid" bindtap="save">
      <text wx:if="{{mode === 'batch'}}">保存并下一张</text>
      <text wx:else>{{isEdit ? '保存修改' : '保存'}}</text>
    </view>
  </view>
</view>
