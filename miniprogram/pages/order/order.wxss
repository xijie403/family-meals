.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
  box-sizing: border-box;
  background: var(--bg);
}

/* 头部沿用全局 .hd，这里只收紧下边距 */

.hd {
  flex-shrink: 0;
  padding-bottom: 4rpx;
}

/* 标题左、搜菜按钮右，按钮不占额外高度 */
.hd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hd-l {
  flex: 1;
  min-width: 0;
}

.hd-search {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: var(--sh-1);
  color: var(--brand-deep);
  font-size: 25rpx;
  font-weight: 600;
  transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
}

.hd-search.on {
  background: linear-gradient(135deg, var(--brand-2), var(--brand-3));
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 44, 0.28);
}

/* 放大镜：一个圆环 + 一根斜柄，纯 CSS 画，不用图片 */
.si {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  color: var(--brand-deep);
}

.hd-search.on .si {
  color: #fff;
}

.si-grey {
  color: #C4B6A4;
}

.si-lens {
  width: 19rpx;
  height: 19rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}

.si-grip {
  position: absolute;
  right: 0;
  bottom: 2rpx;
  width: 11rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
  transform: rotate(45deg);
}

/* ---------------- 搜索框 ---------------- */

.sbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 34rpx 12rpx;
}

.sbar-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: var(--sh-1);
}

.sbar-input {
  flex: 1;
  min-width: 0;
  /* 原生 input 必须给显式高度，否则安卓上文字会被裁 */
  height: 76rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.sbar-ph {
  color: #C4B6A4;
  font-size: 27rpx;
}

.sbar-clear {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #F1E7DC;
  color: #9A8570;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sbar-cancel {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-deep);
}

.search-line {
  font-size: 24rpx;
  color: var(--muted);
  padding: 2rpx 26rpx 14rpx;
}

/* ---------------- 日期条 + 选日期 ---------------- */

.days-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 4rpx 0 12rpx;
}

/* 这一层「可收缩的盒子」是必须的，别删：
   flex 子项默认 min-width:auto，而 scroll-view 里是 white-space:nowrap 的长条内容，
   会把 scroll-view 撑到内容全宽（15 天 ≈ 1650rpx），
   于是右边的「更多」被整个挤出屏幕 —— 表现就是「看不到日历按钮」。
   套一层 flex:1 + min-width:0 + overflow:hidden 的盒子，scroll-view 才会只占剩余宽度。 */
.days-box {
  position: relative;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

/* 日期条的宽度账（改任何一个数都要重算，别拍脑袋改）：
   750 = 26（.days padding-left）
       + 600（6 天 ×(90 宽 + 10 间距)，第 6 格自己那 10rpx 间距也在里面）
       + 16（.days padding-right，被遮罩盖着）
       + 92（「更多」宽）+ 16（「更多」右间距）
   所以默认正好完整显示 6 天，第 7 天从 x=626 开始，恰好藏在 16rpx 的遮罩后面，一点都不露。 */
.days {
  width: 100%;
  white-space: nowrap;
  padding: 8rpx 16rpx 8rpx 26rpx;
  box-sizing: border-box;
}

/* 盖在最后一格位置上的同色遮罩（颜色必须等于页面底色 --bg，否则会看到一条色带） */
.days-fade {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 16rpx;
  background: var(--bg);
  pointer-events: none;
}

.day {
  display: inline-block;
  width: 90rpx;
  margin-right: 10rpx;
  padding: 13rpx 0 11rpx;
  border-radius: 24rpx;
  text-align: center;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(178, 140, 102, 0.07);
  transition: background 0.18s ease, box-shadow 0.18s ease;
}

/* 今天（还没被选中时）：淡淡的橙底，一眼就能找到「今天」这个锚点。
   注意顺序：这段必须在 .day.on 之前，选中时才会被选中态的渐变盖住。 */
.day.today {
  background: var(--brand-soft);
}

.day-tag {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.3;
}

.day-num {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
}

.day.today .day-tag {
  color: #E39A6E;
}

.day.today .day-num {
  color: var(--brand-deep);
}

.day-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin: 6rpx auto 0;
  background: transparent;
}

.day-dot.has {
  background: #FFC08F;
}

/* 选中的一天：渐变胶囊 + 橙色光晕 */
.day.on {
  background: linear-gradient(135deg, var(--brand-2), var(--brand-3));
  box-shadow: 0 10rpx 20rpx rgba(255, 107, 44, 0.32);
}

.day.on .day-tag,
.day.on .day-num {
  color: #fff;
}

.day.on .day-tag {
  opacity: 0.88;
}

.day.on .day-dot.has {
  background: #fff;
}

/* 过去的日子：文字变浅，不做整块置灰 */
.day.past .day-num {
  color: #CFC3B3;
}

.day.past .day-tag {
  color: #D8CCBD;
}

.day.past.day.on .day-num,
.day.past.day.on .day-tag {
  color: #fff;
}

/* 日期条右侧的「更多」：高度和圆角刻意跟日期格对齐，
   这样整条看上去是一排齐整的方块，不会像贴着一个小药丸那样浮着。 */
.pick {
  flex-shrink: 0;
  margin-right: 16rpx;
  height: 114rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 6rpx 16rpx rgba(178, 140, 102, 0.14);
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.pick:active {
  transform: scale(0.96);
}

/* 「更多」：常驻在最右，打开日历（日历底部有「回到今天」）。
   宽度写死 92rpx（不靠文字撑），日期条才好按整数格对齐：
   每天 100rpx × 6 天刚好排满，不会出现半截卡片。 */
.pick.more {
  width: 92rpx;
  padding: 0;
  background: #FFE7D5;
  color: var(--brand-deep);
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(255, 140, 70, 0.16);
}

/* ---------------- 左分类 / 右菜品 ---------------- */

.body {
  flex: 1;
  display: flex;
  min-height: 0;
}

.side {
  width: 184rpx;
  flex-shrink: 0;
  background: #FFF4EA;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.side-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin: 0 12rpx 8rpx;
  padding: 16rpx 6rpx;
  border-radius: 26rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #9A8570;
  transition: all 0.18s ease;
}

.side-ico {
  width: 50rpx;
  height: 50rpx;
  display: block;
}

.side-txt {
  line-height: 1.2;
}

/* 选中分类：白色浮起的小卡，不再用左侧色条 */
.side-item.on {
  background: #fff;
  color: var(--brand-deep);
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(255, 150, 90, 0.22);
}

.main {
  flex: 1;
  background: transparent;
  padding: 2rpx 0 0;
  box-sizing: border-box;
}

/* 按分类分组：分组标题 + 两列网格（滑到哪一组，左侧就亮哪一组） */
.sec {
  padding-bottom: 4rpx;
}

.sec-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 26rpx 10rpx;
}

.sec-ico {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  display: block;
}

.sec-name {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--ink);
}

.sec-n {
  font-size: 22rpx;
  color: var(--muted);
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  /* 显式写 padding：不写会被 app.wxss 里 .grid 的 padding 继承，导致卡片和分组标题错位 */
  padding: 0 26rpx 10rpx;
}

.card {
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: var(--sh-1);
  /* 只过渡颜色与阴影：不做位移，切换时卡片尺寸/位置完全不变 */
  transition: background 0.16s ease, box-shadow 0.16s ease;
}

/* 选中：只换底色 + 橙色光晕。
   关键：不抬升、不加描边、不改内边距 —— 卡片高度与位置和未选中一模一样，
   所以反复勾选不会让页面跳动。 */
.card.on {
  background: var(--brand-soft);
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 44, 0.26);
}

.card-img {
  width: 100%;
  height: 240rpx;
  display: block;
  background: #F6EFE7;
  object-fit: cover;
}

.card-ph {
  background: #F6EFE7;
}

.card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  /* 固定行高 + 最小高度：菜名永远占一行，短名长名都是同样的高度 */
  line-height: 36rpx;
  min-height: 36rpx;
  padding: 14rpx 16rpx 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card.on .card-name {
  color: var(--brand-deep);
}

/* 固定最小高度：即使某道菜没填分类，也不会比其他卡片矮，整行卡片高度一致 */
.card-sub {
  font-size: 20rpx;
  color: var(--muted);
  padding: 0 16rpx 16rpx;
  min-height: 20rpx;
  line-height: 1.5;
}

.list-empty {
  padding: 120rpx 26rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

.le-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.le-s {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 10rpx;
  line-height: 1.7;
}

.pad {
  height: 200rpx;
}

.bar {
  font-weight: 700;
}

/* ---------------- 已点菜单弹层 ---------------- */

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(60, 44, 32, 0.40);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease;
  z-index: 40;
}

.sheet-mask.on {
  opacity: 1;
  visibility: visible;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  background: var(--bg);
  border-radius: 44rpx 44rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(90, 60, 30, 0.16);
  display: flex;
  flex-direction: column;
  max-height: 78vh;
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(103%);
  transition: transform 0.28s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.sheet.up {
  transform: translateY(0);
}

.sheet-hd {
  position: relative;
  flex-shrink: 0;
  padding: 34rpx 32rpx 22rpx;
}

/* 右侧两个按钮（清空 + ✕）都要留位置，别让标题/副标题钻到按钮底下 */
.sheet-hd-l {
  padding-right: 210rpx;
}

.sheet-ttl {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.sheet-sub {
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* 「清空」：从原来的底部搬到了标题右边。
   弹层里已经没有「确定」按钮了（点一下就已经存好），
   所以这里只留一个不显眼但找得到的清空入口。 */
.sheet-clear {
  position: absolute;
  right: 106rpx;
  top: 26rpx;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: var(--sh-1);
  color: #8A7660;
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.sheet-clear:active {
  transform: scale(0.96);
}

.sheet-x {
  position: absolute;
  right: 24rpx;
  top: 26rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFF1E6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C08D66;
  font-size: 30rpx;
}

.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 22rpx;
  margin-bottom: 14rpx;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: var(--sh-1);
}

.mseq {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-2), var(--brand-3));
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mthumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #F6EFE7;
  flex-shrink: 0;
  display: block;
  object-fit: cover;
}

.mph {
  background: #F6EFE7;
}

.mmain {
  flex: 1;
  min-width: 0;
}

.mname {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.msub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.mdel {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #FFF3EC;
  color: #DD7B52;
  font-size: 32rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-empty {
  padding: 90rpx 40rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* 弹层底部没有按钮了，最后一条菜离底边留点空 */
.mpad {
  height: 40rpx;
}

/* ---------------- 日历弹层（日期条右侧「更多」） ---------------- */

.cal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 51;
  background: var(--bg);
  border-radius: 44rpx 44rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(90, 60, 30, 0.16);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  transform: translateY(103%);
  transition: transform 0.28s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.cal.up {
  transform: translateY(0);
}

.cal-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 34rpx 14rpx;
}

.cal-nav {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: var(--sh-1);
  color: var(--brand-deep);
  font-size: 34rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-nav:active {
  transform: scale(0.94);
}

.cal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.cal-wds {
  display: flex;
  padding: 8rpx 24rpx 0;
}

.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}

/* 一行 7 格：14.2857% × 7 = 100%，左右各留 24rpx */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 6rpx 24rpx 8rpx;
}

.cal-c {
  position: relative;
  width: 14.2857%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-n {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink);
}

/* 过去的日子文字变浅，但仍可点（补记用） */
.cal-c.past .cal-n {
  color: #CFC3B3;
}

/* 今天：一圈橙色细边，不抢选中态 */
.cal-c.today .cal-n {
  box-shadow: inset 0 0 0 3rpx var(--brand-2);
  color: var(--brand-deep);
  font-weight: 700;
}

/* 选中的那一天：渐变橙圆 */
.cal-c.sel .cal-n {
  background: linear-gradient(135deg, var(--brand-2), var(--brand-3));
  color: #fff;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 44, 0.32);
}

/* 超出「前后一年」范围的日子：淡到几乎看不见，点了也不会跳 */
.cal-c.off .cal-n {
  color: #E4DACD;
}

.cal-c.off.today .cal-n {
  box-shadow: inset 0 0 0 3rpx #EDE3D8;
  color: #D8CCBD;
}

/* 那天已经点过菜：数字下面一个小圆点（和日期条同一个信号） */
.cal-dot {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  margin-left: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FFC08F;
}

.cal-c.sel .cal-dot {
  background: #fff;
}

.cal-ft {
  padding: 10rpx 34rpx 6rpx;
}

.cal-today {
  height: 92rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: var(--sh-1);
  color: var(--brand-deep);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-today:active {
  transform: scale(0.99);
}
